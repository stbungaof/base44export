# --- API ---
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://converter:converter@localhost:5432/converter

# --- Storage (all configurable; defaults derive from DATA_DIR) ---
DATA_DIR=./data
# UPLOADS_DIR=/data/uploads
# PROJECTS_DIR=/data/projects
# OUTPUT_DIR=/data/output
# LOGS_DIR=/data/logs
# TEMP_DIR=/data/temp

# --- Limits ---
MAX_UPLOAD_MB=512
MAX_UNCOMPRESSED_MB=2048
MAX_ENTRIES=50000
CONCURRENCY=1

# Run `npm install && npm run build` on the converted frontend during validation (slow, needs network)
VALIDATE_BUILD=false

# --- docker compose ---
POSTGRES_USER=converter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=converter
APP_PORT=4000
